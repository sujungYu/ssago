# 이 파일을 .env.local로 복사해 값을 넣으세요. 실제 값은 Git에 커밋하지 않습니다(.env*는 .gitignore 대상).
# 예약·업체·결제 데이터는 목업이라 키가 필요 없고, 로그인·회원가입만 Supabase Auth에 실제로 연결합니다.

# --- Supabase Auth ---
# 없으면 앱이 "로그인 서버 연결이 설정되지 않았어요"를 안내하고 로그인할 수 없습니다(모의 로그인 없음).
# 값 위치: Supabase 대시보드 → Project Settings → API Keys / Data API

# 프로젝트 URL (공개 가능 값). 예: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# publishable 키(sb_publishable_...) 권장. 브라우저에 노출되는 공개 키이며 데이터 보호는 RLS가 전제입니다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# publishable 키 대신 기존 anon(legacy) 키를 쓸 때만 사용
# VITE_SUPABASE_ANON_KEY=

# 주의: service_role / secret 키는 절대 넣지 마세요. VITE_ 변수는 모두 브라우저 번들에 포함됩니다.

# 대시보드의 최소 비밀번호 길이와 같은 값(Supabase 기본 6). 화면 안내·사전 검증용이며 최종 판정은 Supabase가 합니다.
VITE_AUTH_PASSWORD_MIN_LENGTH=6

# --- 개발용 ---
# 데모 빌드에서만 개발용 시나리오 도구를 노출합니다. (운영 빌드는 설정하지 않음)
# VITE_ENABLE_DEV_TOOLS=true

# --- 이후 (미연결) ---
# 주소·지도 공급자, PG, 알림 공급자 키는 서버 전용 — 공급자 미정
